{
  "name": "media-market-challenge-paula",
  "version": "1.0.0",
  "private": true,
  "description": "MediaMarktSaturn Store Apps Platform coding challenge — order management GraphQL API",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.7",
    "inversify": "^6.2.0",
    "mongodb": "^6.21.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
